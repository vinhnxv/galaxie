# macOS
.DS_Store

# Dependencies and build output
node_modules/
dist/

# Local environment files and secrets
.env
.env.*
!.env.example

# Maintainer-only notes (see AGENTS.md); never committed
/internal/

# Local tool data on the maintainer's machine (see AGENTS.md): the CodeGraph index and the Beads backlog
/.codegraph/
/.beads/

# Generated corpus; build explicitly with the example corpus command.
/examples/rag-browser/public/data/squad-dev.json

# Verified Python wheels and local interpreter/build output.
/.cache/
/python/.venv/
/python/**/build/
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/

# Vitest browser-mode failure screenshots and attachments
/.vitest/
