{
  "include": [
    "python/galaxie/src",
    "python/galaxie/tests",
    "python/standins",
    "examples/rag-browser/agent_py",
    "tests/conformance/cases-python",
    "scripts",
    "tests/conformance/cases-pydantic-ai"
  ],
  "venvPath": "python",
  "venv": ".venv",
  "pythonVersion": "3.14",
  "typeCheckingMode": "standard",
  "extraPaths": [
    "python/galaxie/src",
    "examples/rag-browser/agent_py",
    "tests/conformance/cases-python"
  ],
  "exclude": ["**/build", "**/node_modules", "**/__pycache__", "**/.*"],
  "executionEnvironments": [
    {
      "root": "tests/conformance/cases-pydantic-ai",
      "extraPaths": ["python/galaxie/src", "tests/conformance/cases-pydantic-ai"]
    },
    {
      "root": "scripts/record-pydantic-ai-conformance.py",
      "extraPaths": ["python/galaxie/src", "tests/conformance/cases-pydantic-ai"]
    }
  ]
}
