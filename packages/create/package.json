{
  "name": "@galaxie-ai/create",
  "version": "0.2.0",
  "description": "CLI and dependency-free composer for galaxie starter layers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinhnxv/galaxie.git",
    "directory": "packages/create"
  },
  "homepage": "https://github.com/vinhnxv/galaxie/tree/main/packages/create#readme",
  "bugs": {
    "url": "https://github.com/vinhnxv/galaxie/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "type": "module",
  "bin": {
    "create": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "skills",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prepack": "pnpm exec tsc -p tsconfig.build.json && node ../../scripts/prepare-create.ts",
    "postpack": "node ../../scripts/prepare-create.ts --clean",
    "clean:pack": "node ../../scripts/prepare-create.ts --clean"
  },
  "devDependencies": {
    "@google/adk": "2.3.0",
    "@langchain/core": "1.2.20",
    "@langchain/langgraph": "1.5.1",
    "@langchain/openai": "1.6.3",
    "@mlc-ai/web-llm": "0.2.86",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "zod": "4.6.7"
  }
}
