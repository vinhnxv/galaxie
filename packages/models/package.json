    },
    "@mlc-ai/web-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "1.2.20",
    "@langchain/openai": "1.6.3",
    "@mlc-ai/web-llm": "0.2.86",
    "zod": "4.6.7"
  }
