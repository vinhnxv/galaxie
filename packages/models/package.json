{
  "name": "@galaxie/models",
  "version": "0.0.0",
  "private": true,
  "description": "Mock, WebLLM, Chrome Built-in AI and OpenAI-compatible model providers for galaxie.",
  "license": "AGPL-3.0-only",
  "type": "module",
