{
  "name": "@galaxie-ai/adapter-go",
  "version": "0.2.0",
  "description": "Google ADK (Go) executor for galaxie: Go compiled to WebAssembly in a Worker, with policy kept in JavaScript.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinhnxv/galaxie.git",
    "directory": "packages/adapter-go"
  },
  "homepage": "https://github.com/vinhnxv/galaxie/tree/main/packages/adapter-go#readme",
  "bugs": {
    "url": "https://github.com/vinhnxv/galaxie/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "type": "module",
  "sideEffects": [
    "./src/worker.ts",
    "./dist/worker.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@galaxie-ai/core": "workspace:*",
    "@galaxie-ai/adapter-kit": "workspace:*"
  },
  "peerDependencies": {
    "@langchain/core": "~1.2.20"
  },
  "devDependencies": {
    "@langchain/core": "1.2.20",
    "zod": "4.6.7"
  }
}
