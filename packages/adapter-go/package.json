{
  "name": "@galaxie/adapter-go",
  "version": "0.0.0",
  "private": true,
  "description": "Google ADK (Go) executor for galaxie: Go compiled to WebAssembly in a Worker, with policy kept in JavaScript.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "./src/worker.ts",
    "./dist/worker.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@galaxie/core": "workspace:*"
  }
}
