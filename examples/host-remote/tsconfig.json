{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": {
      "@galaxie-ai/adapter-kit": ["../../packages/adapter-kit/src/index.ts"],
      "@galaxie-ai/core/browser": ["../../packages/core/src/browser.ts"],
      "@galaxie-ai/core": ["../../packages/core/src/index.ts"],
      "@galaxie-ai/ui-protocol": ["../../packages/ui-protocol/src/index.ts"],
      "@galaxie-ai/adapter-langgraph": ["../../packages/adapter-langgraph/src/index.ts"],
      "@galaxie-ai/models/mock": ["../../packages/models/src/mock.ts"],
      "@galaxie-ai/models/builtin-ai": ["../../packages/models/src/builtin-ai/index.ts"],
      "@galaxie-ai/react": ["../../packages/react/src/index.ts"],
      "@galaxie-ai/example-english-tutor": ["../english-tutor/src/index.ts"],
      "react": ["../../packages/react/node_modules/@types/react/index.d.ts"],
      "react/*": ["../../packages/react/node_modules/@types/react/*.d.ts"],
      "react-dom/*": ["../../packages/react/node_modules/@types/react-dom/*.d.ts"],
      "@galaxie-ai/models/openai": ["../../packages/models/src/openai/index.ts"]
    }
  },
  "include": ["src", "server", "vite.config.ts"]
}
