{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@galaxie/adapter-kit": ["../../packages/adapter-kit/src/index.ts"],
      "@galaxie/core/browser": ["../../packages/core/src/browser.ts"],
      "@galaxie/core": ["../../packages/core/src/index.ts"],
      "@galaxie/adapter-adk": ["../../packages/adapter-adk/src/index.ts"],
      "@galaxie/adapter-go": ["../../packages/adapter-go/src/index.ts"],
      "@galaxie/adapter-pyodide": ["../../packages/adapter-pyodide/src/index.ts"],
      "@galaxie/models/mock": ["../../packages/models/src/mock.ts"],
      "@galaxie/models/transformers": ["../../packages/models/src/transformers/index.ts"],
      "@galaxie/models/transformers/worker": ["../../packages/models/src/transformers/worker.ts"],
      "@galaxie/adapter-pyodide/worker": ["../../packages/adapter-pyodide/src/worker.ts"],
      "@galaxie/react": ["../../packages/react/src/index.ts"],
      "@galaxie/storage-indexeddb": ["../../packages/storage-indexeddb/src/index.ts"],
      "@galaxie/adapter-go/worker": ["../../packages/adapter-go/src/worker.ts"],
      "react": ["../../packages/react/node_modules/@types/react/index.d.ts"],
      "react/*": ["../../packages/react/node_modules/@types/react/*.d.ts"],
      "react-dom/*": ["../../packages/react/node_modules/@types/react-dom/*.d.ts"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src", "vite.config.ts"]
}
