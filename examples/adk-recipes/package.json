{
  "name": "@galaxie/example-adk-recipes",
  "version": "0.0.0",
  "private": true,
  "description": "A fixture-only browser host scaffold for ADK recipe demonstrations.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite build --mode mock && vite preview --mode mock --host 127.0.0.1 --port 4173 --strictPort",
