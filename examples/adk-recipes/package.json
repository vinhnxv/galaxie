    "preview": "vite preview",
    "test": "vitest run --root ../.. examples/adk-recipes"
  },
  "dependencies": {
    "@galaxie/core": "workspace:*",
    "@galaxie/models": "workspace:*",
    "@galaxie/adapter-adk": "workspace:*",
    "@galaxie/adapter-pyodide": "workspace:*",
    "@galaxie/adapter-go": "workspace:*",
    "@google/adk": "2.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "vite": "8.3.4"
  }
}
