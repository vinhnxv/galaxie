{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "declaration": false,
    "isolatedDeclarations": false,
    "paths": {
      "@galaxie-ai/core/browser": ["../../packages/core/src/browser.ts"],
      "@galaxie-ai/core": ["../../packages/core/src/index.ts"],
      "@galaxie-ai/adapter-langgraph": ["../../packages/adapter-langgraph/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "scripts"]
}
