      "root|response:double",
      "root|text:confirmed"
    ],
    "extra": {
      "asks": 1,
      "modelCalls": 2,
      "runsAfterAnswer": 1,
      "runsWhilePaused": 0
    }
  },
  "function-tool": {
    "events": ["root|call:double", "root|response:double", "root|text:42"],
    "extra": {
      "modelCalls": 2
    }
  },
  "long-running": {
    "events": [
      "root|call:lookup|long-running",
      "root|response:lookup",
      "root|text:working on it",
      "root|text:looked up"
    ],
    "extra": {
      "modelCalls": 3,
      "pending": 1
    }
  },
  "loop": {
    "events": [
      "worker|text:pass one",
      "worker|call:exit_loop",
      "worker|response:exit_loop|escalate"
    ],
    "extra": {
      "modelCalls": 2
    }
  },
  "model-error": {
    "events": [],
    "extra": {
      "error": "model unavailable",
      "failed": true
    }
  },
  "output-schema": {
    "events": ["root|text:{\"answer\":\"yes\"}"],
    "extra": {
      "modelCalls": 1
    }
  },
  "parallel": {
    "events": ["left|text:left done", "right|text:right done"],
