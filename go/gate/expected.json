      "left": 1,
      "right": 1
    }
  },
  "plain-text": {
    "events": ["root|text:hello"],
    "extra": {
      "modelCalls": 1
    }
  },
  "restore": {
    "events": ["root|text:second answer"],
    "extra": {
      "restoredRecords": 2,
      "roundTrips": true,
      "sawHistory": true
    }
  },
  "sequential": {
    "events": ["left|text:left done", "right|text:right done"],
    "extra": {
      "left": 1,
      "right": 1
    }
  },
  "streaming": {
    "events": ["root|partial|text:Hel", "root|partial|text:lo ", "root|text:Hello world"],
    "extra": {
      "streamFlags": [true]
    }
  },
  "tool-error": {
    "events": ["root|call:double", "root|response:double", "root|text:recovered"],
    "extra": {
      "failed": false,
      "modelCalls": 2
    }
  },
  "transfer": {
    "events": [
      "root|call:transfer_to_agent",
      "root|response:transfer_to_agent|transfer:helper",
